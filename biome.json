{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!dist-*",
      "!**/node_modules",
      "!packages/locales/lib/**/*.json",
      "!packages/masterfile/lib/data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "css": {
    "formatter": { "quoteStyle": "single" },
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    },
    "globals": ["CONFIG", "Bun"]
  },
  "overrides": [
    {
      "includes": ["app/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "security": { "noDangerouslySetInnerHtml": "off" },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useValidAriaRole": "off"
      },
      "style": {
        "useTemplate": "off",
        "noParameterAssign": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noDoubleEquals": "off",
        "noThenProperty": "off",
        "useIterableCallbackReturn": "off",
        "noExplicitAny": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noImportantStyles": "off",
        "noThisInStatic": "off"
      },
      "correctness": {
        "useHookAtTopLevel": "off",
        "useExhaustiveDependencies": "off"
      },
      "performance": {
        "noDynamicNamespaceImportAccess": "off"
      }
    }
  }
}
