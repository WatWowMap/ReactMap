{
  "name": "reactmap",
  "version": "1.50.2",
  "private": true,
  "description": "React based frontend map.",
  "license": "MIT",
  "author": "TurtIeSocks <58572875+TurtIeSocks@users.noreply.github.com>",
  "main": "ReactMap.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run masterfile",
    "build": "vite build",
    "config:check": "bun run --filter @rm/config check",
    "config:env": "bun run --filter @rm/config generate",
    "dev": "NODE_ENV=development bun --watch server/src/index.js",
    "lint": "biome check",
    "format": "biome check --write --unsafe",
    "locales:create": "bun run --filter @rm/locales create",
    "locales:generate": "bun run --filter @rm/locales generate",
    "locales:missing": "bun run --filter @rm/locales missing",
    "masterfile": "bun run --filter @rm/masterfile generate",
    "migrate:latest": "knex --knexfile server/src/db/knexfile.cjs migrate:latest",
    "migrate:make": "knex --knexfile server/src/db/knexfile.cjs migrate:make",
    "migrate:rollback": "knex --knexfile server/src/db/knexfile.cjs migrate:rollback",
    "release": "vite build -- -r",
    "server": "bun server/src/index.js",
    "start": "bun .",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "prepare": "husky install",
    "watch": "vite"
  },
  "nodemonConfig": {
    "watch": [
      "server/src/**/*.js",
      "config/default.json",
      "packages/**/*"
    ],
    "ignore": [
      "server/src/configs/koji_backups/**",
      "server/src/models/queries/**",
      "packages/masterfile/lib/data/*",
      "logs"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      {
        "name": "develop",
        "prerelease": true
      },
      {
        "name": "v2",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "bun.lock"
          ],
          "message": "chore(release): ${nextRelease.gitTag} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ],
    "preset": "angular"
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
