{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/src/auth/**/*.js",
    "server/src/middleware/**/*.js",
    "server/src/db/**/*.js"
  ]
}
